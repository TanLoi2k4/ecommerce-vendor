# Base URL for REST API (proxied to API Gateway in dev)
# Gateway routes /api/vendors/** → vendor-service :8081
VITE_API_BASE_URL=/api

# API Gateway target used by Vite dev proxy (optional)
# VITE_GATEWAY_URL=http://localhost:8080

# WebSocket URL for chat (optional — defaults to same origin /ws)
# VITE_WS_URL=http://localhost:8080/ws
